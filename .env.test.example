# Integration Test Configuration
# Copy this file to .env.test and fill in your test environment values.
# DO NOT commit .env.test to version control.
#
# You can copy baseUrl, apiPath, userApiBaseUrl, userApiPath, identityId, awsRegion,
# userPoolId, clientId, and iotEndpoint from your target app's config (e.g.
# esp-rainmaker-home unifiedcdf-integration.ts or similar) so tests run against
# the same backend.

# Required: ESP RainMaker Neo API Configuration
RMNEO_BASE_URL=https://your-api.execute-api.region.amazonaws.com
RMNEO_IDENTITY_ID=region:uuid-identity-id
RMNEO_AWS_REGION=ap-south-1
RMNEO_USER_POOL_ID=region_XXXXXXXX
RMNEO_CLIENT_ID=your-client-id
RMNEO_IOT_ENDPOINT=xxxxx-ats.iot.region.amazonaws.com

# Optional: API paths (if your app uses custom paths)
# RMNEO_API_PATH=/prod
# RMNEO_USER_API_BASE_URL=https://your-user-api.execute-api.region.amazonaws.com
# RMNEO_USER_API_PATH=/prod

# ── Single-user integration tests ───────────────────────────────────────────
# Used by ESPRMNeoAuth.integration.test.ts and ESPRMNeoUser.integration.test.ts.
# Fallback for RMNEO_TEST_PRIMARY_USERNAME when that is not set.
# RMNEO_TEST_USERNAME=user@example.com
# RMNEO_TEST_PASSWORD=password-here

# Also accepted as CDK-style names (used by unifiedcdf-integration.ts):
# TEST_USERNAME=user@example.com
# TEST_PASSWORD=password-here

# ── Two-user live workflow: Node Group Sharing ───────────────────────────────
# Required by __tests__/integration/NodeGroupSharing.integration.test.ts.
# The suite is automatically skipped when these are absent — safe in CI.
#
# PRIMARY  — the account that creates and shares the group.
# RECIPIENT — the account that receives and accepts the invitation.
# Use two separate test accounts on the same backend deployment.
#
RMNEO_TEST_PRIMARY_USERNAME=primary@example.com
RMNEO_TEST_PRIMARY_PASSWORD=primary-password-here
RMNEO_TEST_RECIPIENT_USERNAME=recipient@example.com
RMNEO_TEST_RECIPIENT_PASSWORD=recipient-password-here
