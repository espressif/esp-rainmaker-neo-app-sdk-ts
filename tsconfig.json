{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "noEmit": false,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "declarationDir": "dist/types",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
